# Scanner state (large, grows unbounded, reconstructable).
# Lives in GHA cache between workflow runs, never committed.
full.db
full.db-shm
full.db-wal
# Glob, not the bare name: the merged per-channel log is gzipped, and a
# literal `full.jsonl` silently stops matching the moment the extension
# changes. The analyze job writes it inside the published channel dir.
full.jsonl*

# Python
__pycache__/
*.pyc
.venv/
.uv-cache/

# Editor
.vscode/
.idea/
*.swp
